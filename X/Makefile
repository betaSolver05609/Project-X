# Compiler
CXX = g++
CXXFLAGS = -std=c++17 -Wall -I. -MMD -MP -pthread
LDFLAGS = -ljsoncpp -pthread

# Winsock is only needed on Windows; POSIX sockets need no extra link flag.
ifeq ($(OS),Windows_NT)
	LDFLAGS += -lws2_32
endif

# Three entry points, three binaries: the local REPL, the server, and the network client.
MAIN_LOCAL  = ./db-start.cpp
MAIN_SERVER = ./server-start.cpp
MAIN_CLIENT = ./client-start.cpp

# Find all .cpp files recursively
ALL_SRC = $(shell find . -name "*.cpp")
DEP = $(ALL_SRC:.cpp=.d)

# db_start and db_server share the whole command/storage layer.
SHARED_SRC = $(filter-out $(MAIN_LOCAL) $(MAIN_SERVER) $(MAIN_CLIENT), $(ALL_SRC))
SHARED_OBJ = $(SHARED_SRC:.cpp=.o)

# db_client is intentionally minimal: it only needs the socket layer, not the DB engine.
CLIENT_OBJ = $(MAIN_CLIENT:.cpp=.o) ./socket-utils/socket_io.o

# Default target
all: db_start db_server db_client

db_start: $(MAIN_LOCAL:.cpp=.o) $(SHARED_OBJ)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)

db_server: $(MAIN_SERVER:.cpp=.o) $(SHARED_OBJ)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)

db_client: $(CLIENT_OBJ)
	$(CXX) $(CXXFLAGS) $^ -o $@ $(LDFLAGS)

# Include dependency files generated by -MMD
-include $(DEP)

# Run the local REPL
run: db_start
	./db_start

# Clean compiled files
clean:
	find . -name "*.o" -o -name "*.d" -delete
	find . -name "*.o" -type f -delete
	rm -f db_start db_server db_client
